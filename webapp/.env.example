DATABASE_URL=postgresql+psycopg2://valorant:valorant@localhost:5432/valorant_igl_tutor
# Neon (deployed): use the DIRECT (non-pooled) host, not the "-pooler" one —
# Neon's pooled/PgBouncer endpoint doesn't reliably apply this role's search_path,
# which breaks unqualified table lookups. This app's traffic is low enough that
# direct connections are fine.
# postgresql+psycopg2://<user>:<password>@<host>.<region>.aws.neon.tech/<db>?sslmode=require&channel_binding=require
SESSION_SECRET=change-me
